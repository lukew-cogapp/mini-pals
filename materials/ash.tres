[gd_resource type="StandardMaterial3D" load_steps=9 format=3]

; Scorched ground. Cellular noise in "distance to edge" mode draws the cracks:
; the value falls to zero along the boundaries between cells, which is exactly
; where a dried, broken crust splits. The same texture drives albedo and
; emission, so every crack that reads dark also glows.

[sub_resource type="FastNoiseLite" id="crack_noise"]
; noise_type 2 is cellular; return_type 0 is distance to the cell edge.
noise_type = 2
frequency = 0.09
cellular_return_type = 0
cellular_jitter = 1.0
fractal_octaves = 2
fractal_lacunarity = 2.5

[sub_resource type="Gradient" id="crack_ramp"]
; Black at the crack itself, then up fast into the crust. The tight first two
; stops keep the cracks thin lines rather than wide smudges. Values are low
; because the sun multiplies them by roughly three before they reach the
; frame, and a mid-brown ramp lands as pale clay.
offsets = PackedFloat32Array(0, 0.06, 0.16, 0.5, 1)
colors = PackedColorArray(0.02, 0.008, 0.004, 1, 0.055, 0.024, 0.012, 1, 0.1, 0.05, 0.028, 1, 0.15, 0.08, 0.045, 1, 0.2, 0.115, 0.07, 1)

[sub_resource type="NoiseTexture2D" id="crack_tex"]
width = 512
height = 512
seamless = true
color_ramp = SubResource("crack_ramp")
noise = SubResource("crack_noise")

[sub_resource type="Gradient" id="glow_ramp"]
; Inverse of the albedo ramp: bright where the crack is, black everywhere
; else, so only the splits emit. This is what must still read once the boss
; fight darkens the world.
offsets = PackedFloat32Array(0, 0.03, 0.08, 0.15, 1)
colors = PackedColorArray(1, 0.42, 0.06, 1, 0.7, 0.22, 0.02, 1, 0.16, 0.04, 0, 1, 0.02, 0, 0, 1, 0, 0, 0, 1)

[sub_resource type="NoiseTexture2D" id="glow_tex"]
width = 512
height = 512
seamless = true
color_ramp = SubResource("glow_ramp")
noise = SubResource("crack_noise")

[sub_resource type="FastNoiseLite" id="soot_noise"]
; Broad drifts of soot, far coarser than the cracks, so the crust is not an
; even field of identical cells.
noise_type = 1
frequency = 0.02
fractal_octaves = 3

[sub_resource type="NoiseTexture2D" id="soot_tex"]
width = 256
height = 256
seamless = true
noise = SubResource("soot_noise")

[resource]
; Drawn after the grass disc it sits on, which is otherwise a coin-flip
; between two flat sheets a few centimetres apart.
render_priority = 1
albedo_color = Color(1, 1, 1, 1)
albedo_texture = SubResource("crack_tex")
roughness = 1.0
roughness_texture = SubResource("soot_tex")
; Burnt earth has no sheen. Without this the sun skims a broad highlight
; across the whole blob at eye level, which reads as wet grey slate.
specular_mode = 1
emission_enabled = true
; Low. The glow ramp is bright orange, and anything near 1.0 lifts the whole
; crust to white in daylight and buries the albedo that makes it read as
; earth. This is dim by day and still the only lit thing once the boss fight
; darkens the world.
emission = Color(1, 1, 1, 1)
emission_energy_multiplier = 0.05
emission_texture = SubResource("glow_tex")
; One tile per 2 m, which puts a crack cell at roughly half a metre: big
; enough to read from above, small enough to still be cracks underfoot. At
; 0.09 (one tile per 11 m) the cells were metres wide and read as soft
; blotches rather than a broken crust.
uv1_scale = Vector3(0.5, 0.5, 1)
